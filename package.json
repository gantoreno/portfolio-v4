{
  "name": "portfolio-v4",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter \"@portfolio/*\" dev",
    "dev:astro": "bun run --filter @portfolio/astro dev",
    "dev:next": "bun run --filter @portfolio/next dev",
    "build": "bun run --filter \"@portfolio/*\" build",
    "build:astro": "bun run --filter @portfolio/astro build",
    "build:next": "bun run --filter @portfolio/next build",
    "check": "bun run --filter @portfolio/next check",
    "preview:astro": "bun run --filter @portfolio/astro preview",
    "preview:next": "bun run --filter @portfolio/next start",
    "create:article": "bun run --filter @portfolio/astro create:article",
    "test": "bun test tests"
  }
}
