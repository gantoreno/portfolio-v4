---
import Heading from "@/components/Heading/Heading.astro";
import { getCollection, type CollectionEntry } from "astro:content";

import { isNew } from "@/utils/article";

import Html from "@/layouts/Html.astro";
import Head from "@/layouts/Head.astro";
import Body from "@/layouts/Body.astro";

import EntryAlt from "@/components/EntryAlt/EntryAlt.astro";
import Section from "@/components/Section/Section.astro";
import SectionDivider from "@/components/SectionDivider/SectionDivider.astro";

import Header from "@/components/Header/Header.astro";

export const prerender = true;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

type PostsByYear = {
  [year: string]: CollectionEntry<"blog">[];
};

const postsGroupedByYear = posts.reduce<PostsByYear>((posts, post) => {
  const year = post.data.date.getFullYear();

  if (!posts[year]) posts[year] = [];

  posts[year].push(post);

  return posts;
}, {});
---

<Html>
  <Head
    title="Blog"
    description="Experiences, lessons & more"
    keywords={["Blog", "Writing", "Learning"]}
  />
  <Body>
    <main>
      <Header>
        <Heading level={1}>Experiences, lessons & more {"📖"}</Heading>
      </Header>
      <div class="mt-[60px]">
        {
          Object.keys(postsGroupedByYear)
            .reverse()
            .map((year) => (
              <SectionDivider>
                <span slot="title" class="text-disabled">
                  {year}
                </span>
                <div slot="items">
                  {postsGroupedByYear[year].map((post) => (
                    <Section>
                      <EntryAlt
                        title={post.data.shorthand}
                        description={post.data.description}
                        date={post.data.date}
                        link={"/blog/" + post.id}
                        new={isNew(post.data.date)}
                      />
                    </Section>
                  ))}
                </div>
              </SectionDivider>
            ))
        }
      </div>
    </main>
  </Body>
</Html>
