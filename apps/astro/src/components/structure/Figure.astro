---
import type { HTMLAttributes } from "astro/types";
import { getImage, Image } from "astro:assets";

import Italic from "@/components/typography/Italic.astro";

type Props = Omit<HTMLAttributes<"img">, "src" | "alt"> & {
  src: ImageMetadata;
  alt: any;
  withCaption?: boolean;
};

const { src, alt, title: themeDirective, withCaption = true } = Astro.props;

const preview = await getImage({
  src,
  width: Math.min(src.width, 24),
  quality: 10,
  format: "webp",
});

const width = Math.min(src.width, 1200);
---

<div>
  <figure
    class="mb-[20px]"
    data-blurrable
    data-theme-directive={themeDirective}
  >
    <div class="mb-[20px] rounded-md overflow-hidden">
      <Image
        style={`background-image: url(${preview.src}); background-size: cover;`}
        class="backdrop-blur-md"
        src={src ?? ""}
        alt={alt ?? ""}
        layout="constrained"
        width={width}
        sizes="(max-width: 640px) calc(100vw - 40px), 600px"
        onload="this.dataset.loaded = true"
        data-loaded="false"
      />
    </div>
    {
      withCaption && (
        <figcaption class="text-disabled! text-center">
          <Italic>
            {alt}
            <slot />
          </Italic>
        </figcaption>
      )
    }
  </figure>
</div>
