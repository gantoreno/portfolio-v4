---
import Link from "@/components/Link/Link.astro";
import { format } from "date-fns";

type Props = {
  title: string;
  link: string;
  date: Date;
  description: string;
  new?: boolean;
};

const { title, link, date, description, new: isNew = false } = Astro.props;
---

<div class="flex justify-between gap-[20px] mb-5">
  <div>
    <span class="block mb-[5px]"
      >{isNew ? "✨ " : ""}<Link href={link}>{title}</Link></span
    >
    <p class="prose-paragraph mb-0!">{description}</p>
  </div>
  <span class="text-disabled">{format(date, "MM/dd")}</span>
</div>
