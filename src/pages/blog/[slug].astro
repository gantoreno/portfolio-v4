---
import ArticleContent from "@/components/ArticleContent/ArticleContent.astro";
import Heading from "@/components/Heading/Heading.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";

import { format } from "date-fns";

import { isNew } from "@/utils/article";

import Html from "@/layouts/Html.astro";
import Head from "@/layouts/Head.astro";
import Body from "@/layouts/Body.astro";

import Entry from "@/components/Entry/Entry.astro";

import signature from "@/images/signature.svg";

import Figure from "@/components/Figure/Figure.astro";

import Link from "@/components/Link/Link.astro";

import Avatar from "@/components/Avatar/Avatar.astro";

export const prerender = true;

type Post = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      otherPosts: posts
        .filter((p) => p.id !== post.id)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
        .slice(0, 3),
    },
  }));
}

const { post, otherPosts } = Astro.props;

const { Content, remarkPluginFrontmatter } = await render(post);

const schema = JSON.stringify({
  "@context": "http://schema.org",
  "@type": "Article",
  name: post.data.title,
  author: {
    "@type": "Person",
    name: post.data.author,
  },
  datePublished: post.data.date,
  // @ts-expect-error
  image: Astro.site.origin + post.data.thumbnail,
  url: Astro.url,
});
---

<Html>
  <Head
    title={post.data.title}
    description={post.data.description}
    keywords={post.data.tags}
    thumbnail={post.data.thumbnail}
  >
    <meta property="og:type" content="article" />
    <meta name="author" property="article:author" content={post.data.author} />
    <meta
      property="article:published_time"
      content={post.data.date.toISOString()}
    />
    <script type="application/ld+json" set:html={schema} />
  </Head>
  <Body>
    <article id="article">
      <Heading level={1} class="mt-[60px]">
        {post.data.title}
      </Heading>
      <p class="prose-paragraph mt-5">
        {post.data.description}
      </p>
      <div
        class="flex gap-2.5 mt-0 mb-[60px] text-disabled! align-center"
        data-blurrable
      >
        <Avatar />
        <div class="inline-flex flex-col">
          <div class="top">
            <Link
              class="decoration-transparent hover:decoration-disabled duration-150"
              href="https://linkedin.com/in/gantoreno"
              target="_blank"
            >
              {post.data.author}
            </Link>
            <span class="mx-[2.5px]">·</span>
            <Link
              class="decoration-transparent hover:decoration-disabled duration-150"
              href="https://linkedin.com/comm/mynetwork/discovery-see-all?usecase=PEOPLE_FOLLOWS&followMember=gantoreno"
              target="_blank"
            >
              Follow
            </Link>
          </div>
          <div class="bottom">
            {remarkPluginFrontmatter.minutesRead}
            <span class="mx-[2.5px]">·</span>
            {format(post.data.date, "MMM d, yyyy")}
          </div>
        </div>
      </div>
      <ArticleContent>
        <Content components={{ img: Figure }} />
      </ArticleContent>
      <Heading id="continue-reading"> Continue reading </Heading>
      {
        otherPosts.map((post: Post) => (
          <Entry
            title={post.data.title}
            description={post.data.description}
            link={"/blog/" + post.id}
            new={isNew(post.data.date)}
          />
        ))
      }
      <Image
        class="dark:invert mt-[60px] w-[200px]"
        src={signature}
        alt="Gabriel Moreno's signature"
      />
    </article>
  </Body>
</Html>
