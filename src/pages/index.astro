---
import CompanyLogo from "@/components/CompanyLogo/CompanyLogo.astro";
import Entry from "@/components/Entry/Entry.astro";
import Header from "@/components/Header/Header.astro";
import Heading from "@/components/Heading/Heading.astro";
import Link from "@/components/Link/Link.astro";
import Section from "@/components/Section/Section.astro";
import SectionDivider from "@/components/SectionDivider/SectionDivider.astro";
import Body from "@/layouts/Body.astro";
import Head from "@/layouts/Head.astro";
import Html from "@/layouts/Html.astro";
import { isNew } from "@/utils/article";
import { getCollection } from "astro:content";

export const prerender = true;

const work = (await getCollection("work"))
  .filter((project) => project.data.enabled)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Html>
  <Head />
  <Body>
    <main>
      <Header>
        <Heading level={1}>Hey there! Gabriel here {"👋🏻"}</Heading>
      </Header>
      <p class="prose-paragraph">
        Software engineer delivering exceptional digital experiences, creating
        scalable, secure &amp; performant solutions, exploring emerging
        technologies, and continuously striving to deliver excellence.
      </p>
      <p class="prose-paragraph">
        Always evolving, learning and improving &ndash; <em
          class="font-serif italic"
        >
          one day at a time{/* */}
        </em>.
      </p>
      <SectionDivider class="mt-[60px]">
        <strong slot="title" class="text-primary">Working at</strong>
        <div slot="items">
          <Section>
            <p class="prose-paragraph">
              <Link
                href="https://metabase.com"
                target="_blank"
                class="inline-flex items-center gap-1 mx-0! align-text-bottom leading-[19.5px]"
              >
                <CompanyLogo /> Metabase
              </Link>, the open source Business Intelligence and Embedded
              Analytics tool that lets everyone work with data.
            </p>
          </Section>
        </div>
      </SectionDivider>
      <SectionDivider>
        <strong slot="title" class="text-primary">Recently built</strong>
        <div slot="items">
          {
            work.map((project) => (
              <Section>
                <Entry
                  title={project.data.title}
                  description={project.data.description}
                  link={project.data.link}
                  external
                />
              </Section>
            ))
          }
        </div>
      </SectionDivider>
      <SectionDivider>
        <strong slot="title" class="text-primary">Writing about</strong>
        <div slot="items">
          {
            posts.map((post) => (
              <Section>
                <Entry
                  title={post.data.shorthand}
                  description={post.data.description}
                  link={"/blog/" + post.id}
                  new={isNew(post.data.date)}
                />
              </Section>
            ))
          }
        </div>
      </SectionDivider>
      <Heading linkable={false}> More about me </Heading>
      <p class="prose-paragraph">
        Apart from my work, I'm all about sharing knowledge, fostering growth,
        and building strong developer communities &ndash; <em
          class="font-serif italic"
        >
          especially through mentoring{/* */}
        </em>.
      </p>
      <p class="prose-paragraph">
        If you're interested in my work and/or skillsets, you can always get in
        touch at <Link href="https://twitter.com/gantoreno">@gantoreno</Link> or
        <Link href="mailto:gantoreno@gmail.com">gantoreno@gmail.com</Link>.
      </p>
    </main>
  </Body>
</Html>
